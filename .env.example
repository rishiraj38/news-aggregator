# Copy to app/.env and fill in values. Never commit real app/.env.

# --- Emails & social (digests + welcome + trial notices) ---
# Canonical site users tap from mail (fixes broken default links — use YOUR deploy URL).
# HELIX_WEBSITE_URL=https://your-app.vercel.app
HELIX_WEBSITE_URL=
# Optional checkout page; defaults to HELIX_WEBSITE_URL + /pricing when unset + website set.
HELIX_PRICING_URL=
# Full profile URL plus handle for typography in HTML (plain https://www.instagram.com/your_username/)
HELIX_INSTAGRAM_URL=
HELIX_INSTAGRAM_HANDLE=

# Instagram Graph — see Meta → Products → Instagram → API setup

META_GRAPH_MEDIA_BASE=https://graph.instagram.com/v21.0

# Public JPEG staging (Instagram `image_url` step).
# META_PUBLIC_IMAGE_UPLOAD=auto  # If CLOUDINARY_* are set, auto prepends Cloudinary before anon hosts.
# META_PUBLIC_IMAGE_UPLOAD=cloudinary  # Unsigned preset only — no API secret needed for uploads.
# META_PUBLIC_IMAGE_UPLOAD_ORDER=cloudinary,catbox,file_io
#
# GitHub Actions: create an unsigned upload preset at https://console.cloudinary.com → Upload → Unsigned uploading,
# then add repository Secrets CLOUDINARY_CLOUD_NAME and CLOUDINARY_UPLOAD_PRESET (see `.github/workflows/instagram_post.yml`).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Legacy anon mirrors (often blocked or flaky in CI): catbox, 0x0.st, file.io, transfer.sh
# META_PUBLIC_IMAGE_UPLOAD_ORDER=catbox,file_io,transfer_sh,zero_x_zero

META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
META_FACEBOOK_PAGE_ID=

# META_SKIP_FACEBOOK_PAGE_STAGING=true

# IMGUR_CLIENT_ID=

# Bypass third-party uploads with your CDN / bucket JPEG:
# INSTAGRAM_SOURCE_IMAGE_URL=https://...

# Optional — not read by publish script today; from Meta app dashboard banner
# META_FACEBOOK_APP_ID=

# --- Groq (LLM curator) pacing — avoid TPM “413 / request too large” on Groq Free ---
# Uses GROQ_API_KEY plus optional GROQ_API_KEY2 (see app/agent/base.py).
# CURATOR_CHUNK_SIZE=10
# CURATOR_DIGEST_SUMMARY_CHARS=420
# GROQ_CHUNK_SLEEP_SECONDS=10            # Pause between chunked curator requests (same vibe as daily_runner’s 10s between users)
# GROQ_AFTER_KEY_ROTATE_SLEEP=2          # Pause after failover to secondary key before retry

