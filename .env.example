# Copy to app/.env and fill in values. Never commit real app/.env.

# Instagram Graph — see Meta → Products → Instagram → API setup

META_GRAPH_MEDIA_BASE=https://graph.instagram.com/v21.0

# Public JPEG staging (Instagram `image_url` step). Default tries catbox → 0x0.st → file.io → transfer.sh.
# META_PUBLIC_IMAGE_UPLOAD=auto
# META_PUBLIC_IMAGE_UPLOAD_ORDER=catbox,file_io,transfer_sh,zero_x_zero

META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
META_FACEBOOK_PAGE_ID=

# META_SKIP_FACEBOOK_PAGE_STAGING=true

# IMGUR_CLIENT_ID=

# Bypass third-party uploads with your CDN / bucket JPEG:
# INSTAGRAM_SOURCE_IMAGE_URL=https://...

# Optional — not read by publish script today; from Meta app dashboard banner
# META_FACEBOOK_APP_ID=
